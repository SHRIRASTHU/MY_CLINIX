# Backend API Base URL
# Local Development: Leave empty to automatically use Vite local proxy (/api/v1 -> http://127.0.0.1:8000/api/v1)
# Production (Vercel): Set to your deployed Render backend service URL:
# VITE_API_BASE_URL=https://myclinix-backend.onrender.com/api/v1
# (Note: Even if entered as https://myclinix-backend.onrender.com without /api/v1, the client will normalize it automatically)
VITE_API_BASE_URL=
