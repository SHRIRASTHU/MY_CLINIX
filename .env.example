# MY CLINIX - Environment Configuration Template
# Database Configuration (PostgreSQL default; supports SQLite for local dev without Docker)
DATABASE_URL=postgresql+psycopg://myclinix_user:myclinix_secure_pwd@localhost:5432/myclinix_db
# SQLite alternative for local testing without PostgreSQL server:
# DATABASE_URL=sqlite:///./myclinix.db

# Security & Authentication
JWT_SECRET_KEY=change_this_to_a_super_secret_64_character_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# AI Document Intelligence
OPENAI_API_KEY=your_openai_api_key_here

# File Storage
UPLOAD_DIRECTORY=./uploads

# Environment
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "https://my-clinix.vercel.app"]
